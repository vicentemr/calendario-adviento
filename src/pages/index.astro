---
import "@fontsource/im-fell-english/400.css";
import "@fontsource/im-fell-english/400-italic.css";
import "@fontsource/caveat-brush/400.css";
import "@fontsource-variable/figtree";
import "../styles/ventana.css";
import { config } from "../data/config";
import { cupones } from "../data/cupones";

const dias = Array.from({ length: 24 }, (_, i) => i + 1);

// Gotas de condensación distintas en cada vidrio (siempre las mismas).
function gotasPara(dia: number) {
  let s = dia * 9301 + 49297;
  const rnd = () => ((s = (s * 9301 + 49297) % 233280) / 233280);
  // Cada gota: brillo pequeño arriba a la izquierda, cuerpo oscuro que
  // refracta y una sombra suave abajo. Densidad distinta por vidrio.
  const cantidad = 8 + Math.floor(rnd() * 9);
  const capas: string[] = [];
  const f = (v: number) => v.toFixed(2);
  for (let i = 0; i < cantidad; i++) {
    const x = rnd() * 92 + 4;
    const y = rnd() * 92 + 4;
    // Unas pocas gotas grandes, el resto finas.
    const r = i < 3 ? rnd() * 1.4 + 2.2 : rnd() * 1 + 1;
    capas.push(
      // Brillo: lo que más se ve de una gota.
      `radial-gradient(circle at calc(${f(x)}% - ${f(r * 0.3)}px) calc(${f(y)}% - ${f(r * 0.35)}px), rgba(255,255,255,.9) 0 ${f(r * 0.38)}px, rgba(255,255,255,0) ${f(r * 0.7)}px)`,
      // Cuerpo: refracción suave, más clara arriba que abajo.
      `radial-gradient(circle at ${f(x)}% calc(${f(y)}% + ${f(r * 0.2)}px), rgba(15,26,31,.2) 0 ${f(r * 0.6)}px, rgba(232,238,240,.22) ${f(r)}px, transparent ${f(r + 0.6)}px)`,
      // Sombrita debajo.
      `radial-gradient(circle at ${f(x)}% calc(${f(y)}% + ${f(r * 0.5)}px), rgba(15,26,31,${i < 3 ? ".32" : ".14"}) 0 ${f(r * 0.85)}px, transparent ${f(r + 0.6)}px)`,
    );
  }
  return capas.join(", ");
}

const datos = { anio: config.anio, firma: config.firma, cupones };
const favicon =
  "data:image/svg+xml," +
  encodeURIComponent(
    `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><rect width="100" height="100" rx="18" fill="#0f1a1f"/><path d="M50 78C24 60 16 42 28 31c9-8 19-3 22 6 3-9 13-14 22-6 12 11 4 29-22 47Z" fill="none" stroke="#c23a4c" stroke-width="8" stroke-linejoin="round"/></svg>`,
  );
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0f1a1f" />
    <meta name="description" content={`Un calendario de adviento para ${config.nombreElla}.`} />
    <link rel="icon" href={favicon} />
    <title>Ventana de Adviento</title>
  </head>
  <body>
    <canvas id="escena" aria-hidden="true"></canvas>

    <main>
      <header class="cabecera">
        <h1>Para ti, {config.nombreElla}</h1>
        <p id="subtitulo">Cada día de diciembre se empaña un vidrio. Límpialo con el dedo.</p>
      </header>

      <section class="ventana" aria-label="Calendario de adviento: 24 vidrios, uno por día">
        <ol class="vidrios">
          {
            dias.map((dia) => (
              <li>
                <button
                  type="button"
                  class="vidrio"
                  data-dia={dia}
                  data-estado="cerrado"
                  aria-label={`Día ${dia}`}
                  style={`--gotas: ${gotasPara(dia)}`}
                >
                  <span class="brillo" aria-hidden="true" />
                  <span class="niebla" aria-hidden="true" />
                  <span class="numero" aria-hidden="true">{dia}</span>
                  <svg class="corazon" viewBox="0 0 100 100" aria-hidden="true">
                    <path
                      pathLength="1"
                      d="M50 80C22 61 13 42 26 30c10-9 21-4 24 7 3-11 14-16 24-7 13 12 4 31-24 50Z"
                    />
                  </svg>
                </button>
              </li>
            ))
          }
        </ol>
      </section>
      <div class="alfeizar" aria-hidden="true"></div>
      <p class="firma">Con amor, {config.firma}</p>
    </main>

    <p id="aviso" class="aviso" role="status" aria-live="polite"></p>

    <dialog id="nota" class="nota" aria-labelledby="nota-titulo">
      <p class="nota-dia"></p>
      <h2 class="nota-titulo" id="nota-titulo"></h2>
      <p class="nota-texto"></p>
      <p class="nota-condiciones"></p>
      <p class="nota-firma">— {config.firma}</p>
      <form method="dialog">
        <button class="nota-cerrar" type="submit">Cerrar</button>
      </form>
    </dialog>

    <script is:inline type="application/json" id="datos-calendario" set:html={JSON.stringify(datos)} />
    <script>
      import "../scripts/calendario.ts";
    </script>
  </body>
</html>
