---
// Diseño 4, "Crepúsculo": casa moderna en un bosque con niebla y una pareja que
// trepa los pinos; adentro, la ventana empañada con las casillas.
import "@fontsource/im-fell-english/400.css";
import "@fontsource/im-fell-english/400-italic.css";
import CasaBosque from "../components/CasaBosque.astro";
import Casa from "../layouts/Casa.astro";
import "../styles/crepusculo.css";
---

<Casa
  diseno="crepusculo"
  acomodo="normal"
  variantes={3}
  vidrio
  colorTema="#1a2b33"
  colorIcono="#3d5560"
  confeti={["#e2ae38", "#fbe9ad", "#8b1a2b", "#c23a4c", "#e8eef0"]}
>
  <canvas slot="fondo" id="escena" aria-hidden="true"></canvas>

  <Fragment slot="fachada">
    <div class="tierra"></div>
    <div class="hogar">
      <CasaBosque />
      <div class="marco-puerta"></div>
      <div class="vano" id="vano">
        <button type="button" class="puerta" id="puerta" aria-label="Tocar la puerta y entrar a la casa">
          <span class="hoja-puerta">
            <span class="mirilla"></span>
            <svg viewBox="0 0 48 48" aria-hidden="true">
              <path d="M24 40C11 31 6 21 13 14c5-5 10-2 11 4 1-6 6-9 11-4 7 7 2 17-11 26Z"></path>
            </svg>
            <span class="perilla"></span>
          </span>
        </button>
      </div>
      <div class="grada"></div>
    </div>
  </Fragment>
</Casa>

<script>
  import "../scripts/crepusculo.ts";
</script>
