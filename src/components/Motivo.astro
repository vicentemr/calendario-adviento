---
// Dibujitos planos que aparecen dentro de cada casilla abierta.
// Clases: a = color principal, b = secundario, t = trazo sin relleno.
interface Props {
  dia: number;
  /** Dibuja siempre un corazón de un solo trazo (días comunes). */
  corazon?: boolean;
}
const { dia, corazon = false } = Astro.props;

const comunes = [
  `<path class="a" d="M24 5 36 21H12ZM24 14 40 35H8Z"/><path class="b" d="M21 35h6v8h-6z"/>`,
  `<path class="a" d="m24 5 5.6 12.4 13.4 1.4-10 9.1 2.8 13.3L24 35.4l-11.8 6.8L15 28.9l-10-9.1 13.4-1.4Z"/>`,
  `<circle class="a" cx="24" cy="28" r="14"/><path class="b" d="M20.5 9h7v5h-7z"/><path class="t" d="M11 29c5 4 21 4 26 0"/>`,
  `<path class="a" d="M18 20h12v22H18z"/><path class="b" d="M24 4c5 6 5 10 0 13-5-3-5-7 0-13Z"/>`,
  `<path class="a" d="M24 8c8 0 11 6 11 14 0 7 2 9 4 12H9c2-3 4-5 4-12 0-8 3-14 11-14Z"/><circle class="b" cx="24" cy="39" r="4"/>`,
  `<path class="a" d="M16 12h14v15l9 5c4 2 3 10-2 10H16Z"/><rect class="b" x="13" y="6" width="20" height="8" rx="2"/>`,
  `<path class="t gordo" d="M17 42V18a8 8 0 0 1 16 0v4"/>`,
  `<path class="a" d="M22 22C8 24 5 16 5 9c9-1 16 3 17 13ZM26 22c14 2 17-6 17-13-9-1-16 3-17 13Z"/><circle class="b" cx="24" cy="28" r="4.5"/><circle class="b" cx="18" cy="35" r="4.5"/><circle class="b" cx="30" cy="35" r="4.5"/>`,
  `<path class="a" d="M24 41C10 31 5 22 11 14c5-6 11-3 13 3 2-6 8-9 13-3 6 8 1 17-13 27Z"/>`,
  `<path class="a" d="M10 20h24v12a9 9 0 0 1-9 9h-6a9 9 0 0 1-9-9Z"/><path class="t" d="M34 24h3a4 4 0 0 1 0 10h-3M17 14c-3-3 3-5 0-9M27 14c-3-3 3-5 0-9"/>`,
  `<path class="a" d="M31 7a18 18 0 1 0 10 27A15 15 0 0 1 31 7Z"/>`,
];

const especiales: Record<number, string> = {
  24: `<path class="a" d="M24 11 34 24H14ZM24 18 38 34H10ZM24 25 42 42H6Z"/><path class="b" d="m24 2 1.9 4 4.4.5-3.3 3 .9 4.4L24 11.7l-3.9 2.2.9-4.4-3.3-3 4.4-.5Z"/><circle class="b" cx="19" cy="31" r="1.8"/><circle class="b" cx="29" cy="28" r="1.8"/><circle class="b" cx="26" cy="37" r="1.8"/>`,
  27: `<path class="a" d="M7 28h34v14H7z"/><path class="b" d="M7 28h34v5c-3 4-6 4-8.5 0-2.5 4-6 4-8.5 0-2.5 4-6 4-8.5 0-2.5 4-5.5 4-8.5 0Z"/><path class="t" d="M24 27V17"/><path class="b" d="M24 6c4 4 3.5 8 0 9.5C20.5 14 20 10 24 6Z"/>`,
  31: `<path class="t" d="M24 18V4M24 30v14M18 24H4M30 24h14M19.8 19.8 10 10M28.2 28.2 38 38M28.2 19.8 38 10M19.8 28.2 10 38"/><circle class="b" cx="24" cy="24" r="4"/>`,
};
const trazo = `<path class="c" pathLength="1" d="M24 40C11 31 6 21 13 14c5-5 10-2 11 4 1-6 6-9 11-4 7 7 2 17-11 26Z"/>`;
const svg = especiales[dia] ?? (corazon ? trazo : undefined) ?? comunes[(dia * 4 + Math.floor(dia / 11) * 3) % comunes.length];
---

<svg class="motivo" viewBox="0 0 48 48" aria-hidden="true" set:html={svg} />
